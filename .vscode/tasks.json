{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Node Server",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Python Server",
      "type": "shell",
      "command": "uvicorn candle_service:app --port 5001",
      "options": { "cwd": "${workspaceFolder}/server/python" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "React Client",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/client" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Start All Servers",
      "dependsOn": ["Node Server", "Python Server", "React Client"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
